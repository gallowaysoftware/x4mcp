<!-- The player's own faction entry. Its <relations> are skipped (a faction is
     a Relation only if it has a player row, and this is the player's own), but
     its <licences> are NOT: this is where a real save keeps the licences the
     player HOLDS, and factions= there names the ISSUERS.
       <licence type="police" factions="argon"/>          -> bought from Argon
       <licence type="hyperion_access" factions="holyorder"/> -> granted by HOP
     A 200-save corpus carries ~20 of these on the player block and exactly
     zero licences anywhere spelled the other way round. -->
<faction id="player">
<relations>
<relation faction="argon" relation="0.42"/>
</relations>
<licences>
<licence type="police" factions="argon"/>
<licence type="station_gen_intermediate" factions="argon teladi"/>
</licences>
</faction>
</factions>
